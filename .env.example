# ---------------------------------------------------------------------------
# myLifeZen — configurazione
# Copia questo file in `.env` (che resta privato) e compila i valori.
# ---------------------------------------------------------------------------

# === Instagram (obbligatorio per pubblicare) ===============================
# IG_USER_ID: ID dell'account Instagram Business/Creator collegato a una Pagina Facebook.
# Ottienilo con: python -m lifezen auth pages --token <TOKEN_UTENTE_FACEBOOK>
IG_USER_ID=

# Token di accesso. Meglio se a lunga durata (60 giorni):
#   python -m lifezen auth exchange --token <TOKEN_BREVE>
IG_ACCESS_TOKEN=

# Servono solo per controllare la scadenza del token (python -m lifezen doctor)
IG_APP_ID=
IG_APP_SECRET=

# Versione delle Graph API. Il client verifica e, se necessario, ripiega
# automaticamente su una versione attiva.
IG_GRAPH_VERSION=v25.0

# === Hosting immagini ======================================================
# Instagram pubblica solo da URL pubblici. Opzioni: github | cloudinary | imgbb | dir
LIFEZEN_IMAGE_HOST=github

# Con host `github`: i JPEG vengono salvati nel repo e serviti da jsDelivr.
LIFEZEN_REPO=LifeZen77/Mylifezen
LIFEZEN_IMAGE_BRANCH=main
LIFEZEN_CDN=jsdelivr            # jsdelivr (veloce) oppure raw
# Permesso richiesto: contents:write. In locale serve un PAT classico o fine-grained.
GITHUB_TOKEN=

# Con host `cloudinary`:
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
# (in alternativa al preset)
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Con host `imgbb`:
IMGBB_API_KEY=

# Con host `dir`: cartella già servita da un tuo web server
PUBLIC_BASE_URL=

# === Comportamento =========================================================
LIFEZEN_TIMEZONE=Europe/Rome
LIFEZEN_DRY_RUN=0               # 1 = genera tutto senza pubblicare
LIFEZEN_CTA_SITE=               # es. https://mylifezen.app (riga extra in caption)

# === Notifiche (facoltative) ===============================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
LIFEZEN_WEBHOOK_URL=            # qualsiasi endpoint riceverà un JSON di esito

# === Google Analytics / utm (facoltativo, solo per link in caption) ========
# LIFEZEN_CTA_SITE=https://mylifezen.app?utm_source=instagram&utm_medium=organic
